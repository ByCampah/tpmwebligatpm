generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Relaciones Auth
  accounts      Account[]
  sessions      Session[]

  // Campos personalizados LigaTPM
  role            String  @default("USER") // USER, MODERATOR, ADMIN
  nickName        String? // Elegido por el usuario para mostrarse
  customAvatarUrl String? // Elegido por el usuario
  discordId       String? // Extraido al iniciar sesion
  
  // Link a perfil de Jugador físico
  playerId        String? @unique
  player          Player? @relation(fields: [playerId], references: [id])
  
  // Equipos donde es capitan/manager
  captainOfTeams  Team[]  @relation("TeamCaptain")
  
  // Noticias creadas
  news            News[]

  // Admin logs
  adminLogs       AdminLog[]
  
  // Prode
  prodePredictions ProdePrediction[]
  trophies         Trophy[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model Player {
  id              String             @id @default(uuid())
  nick            String             @unique
  nationality     String             @default("Sin Nacionalidad")
  primaryPosition String?
  secondaryPosition String?
  
  // Link to User account
  user            User?
  
  // Roster history
  tournamentTeams TournamentPlayer[]
  
  // Match stats history
  matchStats      MatchStat[]
  
  // Trophies/Awards won
  trophies        Trophy[]
  excludedFromTrophies Trophy[] @relation("TrophyExclusions")
  
  // Transfer Market
  isFreeAgent     Boolean            @default(false)
  marketDescription String?
  
  // National Teams
  isNationalTeamCalledUp Boolean      @default(false)
  
  createdAt       DateTime           @default(now())
}

model Team {
  id               String  @id @default(uuid())
  name             String  @unique
  logoUrl          String?
  bannerUrl        String?
  
  // Team Captain / Manager
  captainId        String?
  captain          User?   @relation("TeamCaptain", fields: [captainId], references: [id])
  
  // Tournament participation
  tournaments      TournamentTeam[]
  
  // Match history
  homeMatches      Match[] @relation("HomeMatches")
  awayMatches      Match[] @relation("AwayMatches")
  
  // Trophies/Awards won
  trophies         Trophy[]
  
  // Transfer Market
  isLookingForPlayers Boolean @default(false)
  marketDescription   String?
  
  // National Teams
  isNationalTeam      Boolean @default(false)
  
  createdAt        DateTime @default(now())
}

model Season {
  id               String  @id @default(uuid())
  name             String  @unique // e.g. "Temporada 1"
  isActive         Boolean @default(false)
  
  tournaments      Tournament[]
  
  createdAt        DateTime @default(now())
}

model Category {
  id        String       @id @default(uuid())
  name      String       @unique
  tournaments Tournament[]
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  format    String   @default("LEAGUE") // LEAGUE, CUP, PLAYOFF
  seasonId  String?
  season    Season?   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  isOfficial Boolean  @default(true)
  isActiveExtra Boolean @default(false)
  
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  bracketImageUrl String? // Imagen estática antigua para las llaves
  bracketData     Json?   // JSON interactivo con la estructura de las llaves

  matches    Match[]
  teams      TournamentTeam[]
  trophies   Trophy[] // Trophies awarded in this tournament
  
  createdAt        DateTime @default(now())
}

model TournamentTeam {
  id               String  @id @default(uuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id])
  
  captainId        String?
  players          TournamentPlayer[]
  
  // Manual override fields for historical standings without match data
  manualPoints       Int?
  manualGamesPlayed  Int?
  manualWins         Int?
  manualDraws        Int?
  manualLosses       Int?
  manualGoalsFor     Int?
  manualGoalsAgainst Int?

  // Fase de grupos
  group              String?  // "A", "B", "C", etc.

  @@unique([tournamentId, teamId])
}

model TournamentPlayer {
  id                 String  @id @default(uuid())
  tournamentTeamId   String
  tournamentTeam     TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  
  playerId           String
  player             Player         @relation(fields: [playerId], references: [id])
  
  @@unique([tournamentTeamId, playerId])
}

model Match {
  id               String  @id @default(uuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  homeTeamId       String
  homeTeam         Team       @relation("HomeMatches", fields: [homeTeamId], references: [id])
  
  awayTeamId       String
  awayTeam         Team       @relation("AwayMatches", fields: [awayTeamId], references: [id])
  
  homeScore        Int?
  awayScore        Int?
  homePenaltyScore Int?
  awayPenaltyScore Int?
  
  matchDate        DateTime?
  round            String? // e.g. "Fecha 1", "Semifinal"
  status           String  @default("SCHEDULED") // SCHEDULED, PLAYED
  events           Json?   @default("[]") // Lista de eventos: {type: GOAL|RED, minute: Int, playerId: String, assistId?: String}
  
  // Prode
  showInProde      Boolean @default(false)
  prodeLocked      Boolean @default(false)
  prodePredictions ProdePrediction[]

  stats            MatchStat[]
  
  createdAt        DateTime @default(now())
}

model MatchStat {
  id               String  @id @default(uuid())
  matchId          String
  match            Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  playerId         String
  player           Player  @relation(fields: [playerId], references: [id])
  
  matchTime        Int     @default(0)
  goals            Int     @default(0)
  assists          Int     @default(0)
  teamPoints       Int     @default(0)
  fouls            Int     @default(0)
  fouled           Int     @default(0)
  offsides         Int     @default(0)
  ballLosses       Int     @default(0)
  tacklesWon       Int     @default(0)
  redCards         Int     @default(0)
  
  freeKickGoals    Int     @default(0)
  penaltyGoals     Int     @default(0)
  
  passesMade       Int     @default(0)
  passesTotal      Int     @default(0)
  slidingMade      Int     @default(0)
  slidingTotal     Int     @default(0)
  shotsMade        Int     @default(0)
  shotsTotal       Int     @default(0)
  headersMade      Int     @default(0)
  headersTotal     Int     @default(0)
  
  gkTime           Int     @default(0)
  savesMade        Int     @default(0)
  savesTotal       Int     @default(0)
  cleanSheet       Boolean @default(false)
  penaltiesSaved   Int     @default(0)
  penaltiesConceded Int    @default(0)
  
  @@unique([matchId, playerId])
}


model Trophy {
  id           String   @id @default(cuid())
  name         String
  type         String
  tournamentId String?
  teamId       String?
  playerId     String?
  userId       String?
  createdAt    DateTime @default(now())

  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  team         Team?       @relation(fields: [teamId], references: [id])
  player       Player?     @relation(fields: [playerId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  excludedPlayers Player[] @relation("TrophyExclusions")
}

model News {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model ProdePrediction {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  homeScore    Int
  awayScore    Int
  pointsEarned Int?     // Se llena al terminar el partido (ej. 6 exacto, 3 ganador)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, matchId])
}
